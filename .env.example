# -----------------------------------------------------------------------------
# Variables de entorno de Monedero (desarrollo local).
#
# `dart run tool/up.dart` copia este archivo a `.env` la primera vez y
# reemplaza cada valor __GENERAR__ por un secreto aleatorio.
# NUNCA subas `.env` al repositorio (ya está en .gitignore).
# Producción usa deploy/.env.prod.example, con DEMO_MODE=false.
# -----------------------------------------------------------------------------

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=monedero
# Dueño del esquema (migraciones). La API NO se conecta con este usuario.
POSTGRES_OWNER_USER=monedero_owner
POSTGRES_OWNER_PASSWORD=__GENERAR__
# Usuario de la API con permisos mínimos (sin UPDATE/DELETE en transactions).
# Se crea en la Fase 2.
POSTGRES_APP_USER=monedero_app
POSTGRES_APP_PASSWORD=__GENERAR__
# Puerto en la laptop (cámbialo si ya tienes otro PostgreSQL en 5432).
POSTGRES_PORT=5432

# --- API ---------------------------------------------------------------------
API_PORT=8080
# Orígenes web autorizados por CORS, separados por coma. La app web se corre
# con `flutter run -d chrome --web-port 5000`.
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Modo demo: lista de tarjetas de demostración y botón "Reiniciar demo".
# Desactivado por defecto; en producción SIEMPRE false.
DEMO_MODE=true

# Secreto para firmar los JWT (Fase 2). Mínimo 32 bytes aleatorios.
JWT_SECRET=__GENERAR__
# Duración de los tokens de acceso, en minutos.
JWT_TTL_MINUTES=15
# Duración de los tokens de renovación de sesión (refresh), en días.
REFRESH_TOKEN_TTL_DAYS=7

# Límite de solicitudes por minuto y cliente a /v1/... (0 = sin límite).
RATE_LIMIT_PER_MINUTE=600
# Límite más estricto para inicio de sesión, registro y sesiones demo.
RATE_LIMIT_AUTH_PER_MINUTE=30
# true: identifica al cliente por CF-Connecting-IP / X-Forwarded-For. Hace
# falta detrás del túnel de Cloudflare (tool/share.dart), donde todas las
# solicitudes llegan desde el contenedor del túnel. En producción, true solo
# detrás de un proxy confiable que ponga esos encabezados.
RATE_LIMIT_TRUST_PROXY=true

# Llave maestra para la firma de tarjetas HMAC-SHA256 (Fase 2).
# Solo vive en el servidor; nunca en la app ni en el repositorio.
CARD_MASTER_KEY=__GENERAR__
# Prefijo de los números de tarjeta (16 dígitos con Luhn).
CARD_NUMBER_PREFIX=9990
# Débitos mayores a este monto (en centavos) exigen el PIN del titular.
PIN_REQUIRED_ABOVE_CENTS=2500
# Intentos fallidos permitidos antes de bloquear temporalmente.
MAX_PIN_ATTEMPTS=3
MAX_VERIFICATION_CODE_ATTEMPTS=5

# --- Correo (Mailpit en local) ------------------------------------------------
MAIL_FROM=Monedero <no-responder@monedero.local>

# --- Mailpit -----------------------------------------------------------------
# Interfaz web para ver los correos: http://localhost:8025
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Finales de línea LF en el repositorio para todo el equipo (Windows y macOS).
* text=auto eol=lf

# Scripts de Windows con CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
